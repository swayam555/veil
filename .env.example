# Copy to .env and fill in what you want. Everything is optional: without these, Veil uses its built-in
# simulated models and rule-based AI features, and costs nothing to run.

# A real model behind the proxy (any OpenAI-compatible API). Free tiers work, for example:
#   Groq:   UPSTREAM_BASE_URL=https://api.groq.com/openai/v1  UPSTREAM_MODEL=llama-3.1-8b-instant
#   Gemini: UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  UPSTREAM_MODEL=gemini-2.5-flash
#   Ollama: UPSTREAM_BASE_URL=http://host.docker.internal:11434/v1  UPSTREAM_MODEL=qwen2.5:1.5b  UPSTREAM_API_KEY=ollama
# It becomes the first target of the "gpt-4o-mini" route, with the simulated models as fallbacks.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=

# The LLM for the policy copilot and the incident explainer: none | openai | anthropic | ollama
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Change both in production. Master key: openssl rand -base64 32
JWT_SECRET=change-me-in-production-this-is-a-32+-byte-dev-secret
VEIL_MASTER_KEY=3q2+7wAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
